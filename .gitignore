# ============================================================
# 一站式综合生活助手 · 统一 .gitignore
# 合并了后端（成员1）与 Vue3 管理后台（成员4）两边的忽略规则
# ============================================================

# ---------- 环境变量（禁止提交，只提交 .env.example） ----------
.env
.env.local
.env.test
.env.prod

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# ---------- 数据库 ----------
*.db
*.sqlite3

# ---------- 日志 ----------
logs/
*.log
nohup.out
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- 密钥 / 证书 ----------
*.pem
*.key
*.p12
*.jks
*.keystore

# ---------- Android ----------
.gradle/
build/
local.properties
*.apk
*.aab
captures/
.externalNativeBuild/
.cxx/

# ---------- Node / Vue ----------
node_modules/
dist/
dist-ssr/
*.local
.vite/

# ---------- 编辑器 ----------
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------- 系统 ----------
.DS_Store
Thumbs.db
desktop.ini
