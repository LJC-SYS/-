# ============================================================
# 一站式综合生活助手 · 环境变量示例
# ============================================================
# 使用方式：复制本文件为 .env，按环境修改后使用。
# 禁止将真实 .env 提交到代码仓库。
# ============================================================

# ---------- 运行环境 ----------
# local / test / prod
APP_ENV=local

# ---------- 服务基础 ----------
APP_NAME=生活助手后端
APP_VERSION=1.0.0
# 监听地址：本地开发用 127.0.0.1，联调环境需用 0.0.0.0 供同事访问
APP_HOST=0.0.0.0
APP_PORT=8000

# ---------- 数据库 ----------
# 本地快速开发可用 SQLite（仅单人开发，团队联调必须 PG）
# SQLite:  sqlite:///./life_assistant.db
# PG:      postgresql+psycopg://user:password@host:5432/life_assistant
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/life_assistant

# 连接池（SQLite 下可忽略）
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
# 打印 SQL，仅本地调试开启，测试/正式必须 false
DB_ECHO=false

# ---------- 鉴权 / JWT ----------
# 必须替换为随机长字符串，生成方式：openssl rand -hex 32
JWT_SECRET_KEY=please-change-me-to-a-random-32-bytes-hex-string
JWT_ALGORITHM=HS256
# Access Token 有效期（秒）：2 小时
ACCESS_TOKEN_EXPIRE_SECONDS=7200
# Refresh Token 有效期（天）：14 天
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---------- 业务时区 ----------
# 打卡日期、连续天数计算均使用该时区
BUSINESS_TIMEZONE=Asia/Shanghai

# ---------- 跨域 ----------
# 逗号分隔；* 表示允许全部（仅本地开发使用）
CORS_ORIGINS=*

# ---------- 第三方服务 ----------
# 由成员 2 负责填写与维护，禁止提交真实 Key 到仓库
WEATHER_PROVIDER=
WEATHER_API_KEY=
WEATHER_API_BASE_URL=
# 第三方请求超时（秒）
WEATHER_TIMEOUT_SECONDS=5
# 天气缓存有效期（分钟），建议 5~30
WEATHER_CACHE_MINUTES=30

# ---------- 日志 ----------
LOG_LEVEL=INFO
# 日志文件目录，留空则只输出到控制台
LOG_DIR=logs
